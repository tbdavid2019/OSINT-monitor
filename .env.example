# Finnhub API Key
# Get your free key at: https://finnhub.io/
# Free tier: 60 calls/minute
VITE_FINNHUB_API_KEY=your_api_key_here

# LLM Configuration (Optional)
# If set, these will be used as defaults. Users can still override in Settings.
# Supports OpenAI-compatible APIs (OpenAI, Azure, Ollama, LMStudio, etc.)

# Base URL for LLM API (default: https://api.openai.com/v1)
VITE_LLM_BASE_URL=https://api.openai.com/v1

# Your API Key (keep this secret!)
VITE_LLM_API_KEY=sk-your-api-key-here

# Model to use (default: gpt-4o-mini)
VITE_LLM_MODEL=gpt-4o-mini
