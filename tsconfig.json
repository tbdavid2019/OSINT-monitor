{
	"extends": "$app/tsconfig",
	"compilerOptions": {
		"strict": true,
		"noImplicitAny": true,
		"strictNullChecks": true,
		"noUnusedLocals": true,
		"noUnusedParameters": true,
		"target": "ES2022",
		"lib": ["ES2022", "DOM", "DOM.Iterable"]
	},
	"include": ["src", "vite.config.ts", "playwright.config.ts", "tests"]
}
